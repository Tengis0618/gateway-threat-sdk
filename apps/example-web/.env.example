# Copy to .env.local (git-ignored) and fill in the values for your gateway.
VITE_GATEWAY_API_KEY=pk_sandbox_replace_me
VITE_GATEWAY_ENVIRONMENT=sandbox

# Absolute URL, or a relative path to route requests through the Vite proxy.
VITE_GATEWAY_BASE_URL=/sdk/applepay

# Optional. Prefix for the SDK identification headers. Defaults to X-Pay.
# VITE_GATEWAY_HEADER_PREFIX=X-Pay

# Dev server only, never sent to the browser: where a relative base URL is forwarded.
GATEWAY_PROXY_TARGET=https://gateway.example.com
