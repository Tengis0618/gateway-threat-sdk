// Copy to Secrets.xcconfig (git-ignored) and fill in the values for your gateway.
// xcconfig treats // as a comment, so write URLs as https:/$()/host.

GATEWAY_API_KEY = pk_sandbox_replace_me
GATEWAY_BASE_URL = https:/$()/gateway.example.com/sdk/applepay

// Optional. Prefix for the SDK identification headers. Defaults to X-Pay.
GATEWAY_HEADER_PREFIX =

// Must be the appleMerchantId returned by /v1/session.
GATEWAY_MERCHANT_ID = merchant.com.example.pay

// An App ID with Apple Pay enabled and linked to the merchant ID, and its team.
GATEWAY_BUNDLE_ID = com.example.gatewaypay.demo
GATEWAY_DEVELOPMENT_TEAM = ABCDE12345
