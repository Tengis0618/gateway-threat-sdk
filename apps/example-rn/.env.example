# Copy to .env.local (git-ignored) and fill in the values for your gateway.
GATEWAY_API_KEY=pk_sandbox_replace_me
GATEWAY_ENVIRONMENT=sandbox
GATEWAY_BASE_URL=https://gateway.example.com/sdk/applepay
GATEWAY_WEB_CHECKOUT_URL=https://gateway.example.com/checkout/demo

# Optional. Prefix for the SDK identification headers. Defaults to X-Pay.
# GATEWAY_HEADER_PREFIX=X-Pay
